{
  "name": "parc-auto",
  "version": "2.0.0",
  "private": true,
  "description": "Gestion des véhicules importés : achat à l'étranger, logistique, coût de revient, vente et facturation au Mali.",
  "scripts": {
    "predev": "node scripts/copier-ressources.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copier-ressources.mjs && node scripts/assembler-sql.mjs",
    "build": "next build && node scripts/aplatir-rsc.mjs && node scripts/generer-sw.mjs",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "verifier:demo": "node scripts/verifier-demo.mjs",
    "verifier:workflow": "node scripts/verifier-workflow.mjs",
    "verifier:erreurs": "node scripts/verifier-erreurs.mjs",
    "verifier:accessibilite": "node scripts/verifier-accessibilite.mjs",
    "verifier:parcours": "node scripts/verifier-parcours.mjs",
    "verifier:mise-en-page": "node scripts/verifier-mise-en-page.mjs",
    "verifier:hors-ligne": "node scripts/verifier-hors-ligne.mjs",
    "verifier:navigateur": "npm run verifier:demo && npm run verifier:workflow && npm run verifier:erreurs && npm run verifier:accessibilite && npm run verifier:mise-en-page && npm run verifier:hors-ligne && npm run verifier:parcours",
    "sql:bundle": "node scripts/assembler-sql.mjs",
    "verifier": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/query-async-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@ibm/plex-mono": "2.5.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
