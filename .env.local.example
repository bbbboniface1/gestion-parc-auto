# Projet Supabase (Settings > API). Sans ces valeurs, seule la démonstration est disponible.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Facultatif. La démonstration (entreprise fictive dans le navigateur) est masquée dès que Supabase est configuré.
# Mettre 1 seulement sur un site de présentation.
# NEXT_PUBLIC_DEMO=1
